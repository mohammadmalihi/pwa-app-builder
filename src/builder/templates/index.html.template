<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no" />
<title>{{APP_NAME}}</title>

<link rel="manifest" href="./manifest.webmanifest" />
<link rel="icon" type="image/png" href="./icons/favicon.png" />
<link rel="apple-touch-icon" href="./icons/apple-touch-icon.png" />

<meta name="theme-color" content="{{THEME_COLOR}}" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="{{APP_NAME}}" />

<style>
  :root {
    --theme-color: {{THEME_COLOR}};
    --bg-color: {{BACKGROUND_COLOR}};
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--bg-color);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Tahoma, Vazirmatn, sans-serif;
  }
  #splash {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    background: radial-gradient(circle at 50% 35%, color-mix(in srgb, var(--theme-color) 25%, var(--bg-color)) 0%, var(--bg-color) 70%);
    animation: fadeIn 0.4s ease-out;
  }
  .logo-ring {
    position: relative;
    width: 132px;
    height: 132px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .logo-ring::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 3px solid color-mix(in srgb, var(--theme-color) 30%, transparent);
    border-top-color: var(--theme-color);
    animation: spin 1s linear infinite;
  }
  .logo-wrap {
    width: 96px;
    height: 96px;
    border-radius: 26px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    animation: pulse 1.6s ease-in-out infinite;
  }
  .logo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .app-name {
    color: #fff;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.3px;
    opacity: 0.95;
  }
  .progress-track {
    width: 160px;
    height: 4px;
    border-radius: 999px;
    background: rgba(255,255,255,0.15);
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    width: 40%;
    border-radius: 999px;
    background: var(--theme-color);
    animation: loading 1.1s ease-in-out infinite;
  }
  .loading-text {
    color: rgba(255,255,255,0.6);
    font-size: 12px;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.06); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes loading {
    0% { transform: translateX(-120%); }
    100% { transform: translateX(280%); }
  }
  #target {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: none;
  }
</style>
</head>
<body>
  <div id="splash">
    <div class="logo-ring">
      <div class="logo-wrap">
        <img src="./icons/icon-512.png" alt="{{APP_NAME}}" />
      </div>
    </div>
    <div class="app-name">{{APP_NAME}}</div>
    <div class="progress-track"><div class="progress-fill"></div></div>
    <div class="loading-text">در حال بارگذاری…</div>
  </div>

  <script>
    var TARGET_URL = "{{TARGET_URL}}";
    var MIN_SPLASH_MS = 1400;
    var start = Date.now();

    function goToTarget() {
      var elapsed = Date.now() - start;
      var wait = Math.max(MIN_SPLASH_MS - elapsed, 0);
      setTimeout(function () {
        window.location.replace(TARGET_URL);
      }, wait);
    }

    if (document.readyState === 'complete') {
      goToTarget();
    } else {
      window.addEventListener('load', goToTarget);
    }

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('./sw.js').catch(function () {});
      });
    }
  </script>
</body>
</html>
